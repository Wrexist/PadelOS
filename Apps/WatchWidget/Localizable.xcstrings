    "Court and score of the match you are scoring. Tap to open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملعب ونتيجة المباراة التي تسجّلها. اضغط للفتح."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pista i marcador del partit que estàs anotant. Toca per obrir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurt a skóre zápasu, který počítáte. Klepnutím otevřete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bane og stilling i den kamp, du tæller point i. Tryk for at åbne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platz und Stand des Matches, das du zählst. Zum Öffnen tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pista y marcador del partido que estás anotando. Toca para abrir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pistelaskussa olevan ottelun kenttä ja tilanne. Avaa napauttamalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terrain et score du match que vous arbitrez. Touchez pour ouvrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Campo e punteggio della partita che stai segnando. Tocca per aprire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スコア記録中の試合のコートとスコア。タップして開きます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bane og stilling for kampen du fører poeng i. Trykk for å åpne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baan en score van de wedstrijd die je bijhoudt. Tik om te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kort i wynik meczu, w którym liczysz punkty. Stuknij, aby otworzyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quadra e placar da partida que você está marcando. Toque para abrir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Campo e resultado da partida que está a marcar. Toque para abrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Корт и счёт матча, который вы ведёте. Нажмите, чтобы открыть."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bana och ställning i matchen du räknar poäng i. Tryck för att öppna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你正在记分的比赛的场地和比分。轻点以打开。"
          }
        }
      }
    },
