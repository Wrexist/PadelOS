    "Score from\nyour wrist.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النتيجة\nعلى معصمك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota des\ndel canell."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počítejte skóre\nna zápěstí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tæl point\nfra håndleddet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählen direkt\nam Handgelenk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota desde\ntu muñeca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laske pisteet\nranteesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptez les points\ndepuis votre poignet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna i punti\ndal polso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手首で\nスコアを記録。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Før poeng\nfra håndleddet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scoren vanaf\nje pols."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Licz punkty\nna nadgarstku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque o placar\nno pulso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque pontos\nno pulso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счёт —\nна запястье."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Räkna poäng\nfrån handleden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬腕之间，\n轻松记分。"
          }
        }
      }
    },
    "Score on the watch even without your iPhone nearby. Points are stored on the watch and sent when the devices reconnect.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل النتيجة على الساعة حتى دون وجود iPhone بالقرب منك. تُخزَّن النقاط على الساعة وتُرسل عند إعادة اتصال الجهازين."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota al rellotge encara que l'iPhone no sigui a prop. Els punts es desen al rellotge i s'envien quan els dispositius es tornen a connectar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počítejte skóre na hodinkách i bez iPhonu poblíž. Body se uloží v hodinkách a odešlou se, jakmile se zařízení znovu spojí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tæl point på uret, selv uden din iPhone i nærheden. Point gemmes på uret og sendes, når enhederne får forbindelse igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zähle auf der Watch, auch ohne iPhone in der Nähe. Punkte werden auf der Watch gesichert und gesendet, sobald die Geräte wieder verbunden sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota en el reloj aunque el iPhone no esté cerca. Los puntos se guardan en el reloj y se envían cuando los dispositivos se vuelven a conectar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laske pisteitä kellolla, vaikka iPhone ei olisi lähellä. Pisteet tallentuvat kelloon ja lähetetään, kun laitteet yhdistyvät uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptez les points sur la montre même sans votre iPhone à proximité. Les points sont stockés sur la montre et envoyés dès que les appareils se reconnectent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna i punti sull’orologio anche senza l’iPhone vicino. I punti vengono salvati sull’orologio e inviati quando i dispositivi si riconnettono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneが近くになくてもApple Watchでスコアを記録できます。ポイントはApple Watchに保存され、デバイスが再接続されると送信されます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Før poeng på klokken, selv uten iPhonen i nærheten. Poengene lagres på klokken og sendes når enhetene kobles til igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scoor op de Watch, ook zonder iPhone in de buurt. Punten worden op de Watch bewaard en verstuurd zodra de apparaten weer verbinding hebben."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Licz punkty na zegarku nawet bez iPhone’a w pobliżu. Punkty są zapisywane na zegarku i wysyłane po ponownym połączeniu urządzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque o placar no relógio mesmo sem o iPhone por perto. Os pontos ficam salvos no relógio e são enviados quando os dispositivos se reconectarem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque pontos no relógio mesmo sem o iPhone por perto. Os pontos ficam guardados no relógio e são enviados quando os dispositivos voltarem a ligar-se."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ведите счёт на часах, даже если iPhone далеко. Очки хранятся на часах и передаются, когда устройства снова подключатся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Räkna poäng på klockan även utan din iPhone i närheten. Poängen sparas på klockan och skickas när enheterna återansluter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使 iPhone 不在身边，也能在手表上记分。得分会保存在手表上，并在设备重新连接时发送。"
          }
        }
      }
    },
