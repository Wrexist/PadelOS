    "Too many unsent points. Open the iPhone app to sync.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد كبير من النقاط غير المرسلة. افتح التطبيق على iPhone للمزامنة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Massa punts sense enviar. Obre l'app a l'iPhone per sincronitzar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příliš mnoho neodeslaných bodů. Pro synchronizaci otevřete aplikaci v iPhonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange point, der ikke er sendt. Åbn iPhone-appen for at synkronisere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele nicht gesendete Punkte. Öffne die iPhone-App zum Synchronisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados puntos sin enviar. Abre la app en el iPhone para sincronizar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liikaa lähettämättömiä pisteitä. Synkronoi avaamalla iPhone-appi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de points non envoyés. Ouvrez l’app sur l’iPhone pour synchroniser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi punti non inviati. Apri l’app su iPhone per sincronizzare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未送信のポイントが多すぎます。iPhoneのアプリを開いて同期してください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange usendte poeng. Åpne iPhone-appen for å synkronisere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel onverzonden punten. Open de iPhone-app om te synchroniseren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za dużo niewysłanych punktów. Otwórz aplikację na iPhonie, aby zsynchronizować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitos pontos não enviados. Abra o app no iPhone para sincronizar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados pontos por enviar. Abra a app no iPhone para sincronizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много неотправленных очков. Откройте приложение на iPhone для синхронизации."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För många oskickade poäng. Öppna iPhone-appen för att synka."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未发送的得分过多。请打开 iPhone 上的 App 进行同步。"
          }
        }
      }
    },
