    "%@ %lld, %@ %lld. The result counts towards the standings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld، %@ %lld. تُحتسب النتيجة في الترتيب."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld, %@ %lld. El resultat compta per a la classificació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld, %@ %lld. Výsledek se započítá do pořadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld, %@ %lld. Resultatet tæller med i stillingen."
          }
        },
