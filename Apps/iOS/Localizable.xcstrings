    "Like Americano, but every team has one player from each of your two groups.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثل أمريكانو، لكن كل فريق يضم لاعبًا من كل فئة من فئتيك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Com l'Americano, però cada equip té un jugador de cadascun dels teus dos grups."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jako Americano, ale každý tým má jednoho hráče z každé z vašich dvou skupin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Som Americano, men hvert hold har én spiller fra hver af dine to grupper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie Americano, aber jedes Team hat einen Spieler aus jeder deiner beiden Gruppen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como el Americano, pero cada equipo tiene un jugador de cada uno de tus dos grupos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuten Americano, mutta jokaisessa joukkueessa on yksi pelaaja kummastakin ryhmästäsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme l’Americano, mais chaque équipe compte un joueur de chacun de vos deux groupes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come l’Americano, ma ogni squadra ha un giocatore per ciascuno dei tuoi due gruppi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アメリカーノと同様ですが、各チームに2つのグループから1人ずつ入ります。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Som Americano, men hvert lag har én spiller fra hver av de to gruppene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoals Americano, maar elk team heeft één speler uit elk van je twee groepen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak Americano, ale w każdej drużynie jest gracz z każdej z Twoich dwóch grup."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como o Americano, mas cada dupla tem um jogador de cada um dos dois grupos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Como o Americano, mas cada equipa tem um jogador de cada um dos dois grupos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как Американо, но в каждой команде по игроку из каждой из двух групп."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Som Americano, men varje lag har en spelare från var och en av dina två grupper."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与 Americano 类似，但每支队伍由两组各出一名球员组成。"
          }
        }
      }
    },
