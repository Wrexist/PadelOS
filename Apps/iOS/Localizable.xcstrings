    "Each group needs at least 2 players, so %@ cannot withdraw.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج كل فئة إلى لاعبَين على الأقل، لذا لا يمكن انسحاب %@."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada grup necessita almenys 2 jugadors, així que %@ no es pot retirar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá skupina potřebuje alespoň 2 hráče, takže nelze odhlásit: %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver gruppe skal have mindst 2 spillere, så %@ kan ikke trække sig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Gruppe braucht mindestens 2 Spieler, daher kann sich %@ nicht zurückziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada grupo necesita al menos 2 jugadores, así que %@ no puede retirarse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokaisessa ryhmässä on oltava vähintään 2 pelaajaa, joten pelaajaa %@ ei voi poistaa pelistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque groupe doit compter au moins 2 joueurs : %@ ne peut donc pas être retiré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni gruppo deve avere almeno 2 giocatori, quindi %@ non può ritirarsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各グループに2人以上必要なため、%@は棄権できません。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver gruppe må ha minst 2 spillere, så %@ kan ikke trekkes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke groep vereist minstens 2 spelers, dus %@ kan zich niet terugtrekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda grupa musi mieć co najmniej 2 graczy, więc nie można wycofać: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada grupo precisa de pelo menos 2 jogadores, então não é possível retirar %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada grupo precisa de pelo menos 2 jogadores, por isso não é possível retirar %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В каждой группе должно быть минимум 2 игрока, поэтому %@ не может сняться."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje grupp måste ha minst 2 spelare, så %@ kan inte dra sig ur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每组至少需要2名球员，因此%@无法退赛。"
          }
        }
      }
    },
    "Each player can only be in one team.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لكل لاعب أن يكون في فريق واحد فقط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada jugador només pot ser en un equip."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý hráč může být jen v jednom týmu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver spiller kan kun være på ét hold."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Spieler kann nur in einem Team sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada jugador solo puede estar en un equipo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kukin pelaaja voi olla vain yhdessä joukkueessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque joueur ne peut faire partie que d’une équipe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni giocatore può far parte di una sola squadra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各プレーヤーが入れるチームは1つだけです。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver spiller kan bare være på ett lag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke speler kan maar in één team zitten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy gracz może być tylko w jednej drużynie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada jogador só pode estar em uma dupla."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada jogador só pode estar numa equipa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый игрок может быть только в одной команде."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje spelare kan bara vara med i ett lag."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每名球员只能加入一支队伍。"
          }
        }
      }
    },
    "Each round is drawn from the latest standings when the previous one ends.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحدَّد كل جولة وفق أحدث ترتيب عند انتهاء الجولة السابقة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ronda es genera a partir de la classificació més recent quan acaba l'anterior."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé kolo se sestaví podle aktuálního pořadí po skončení předchozího."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver runde sammensættes ud fra den seneste stilling, når den forrige runde er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Runde wird nach Ende der vorherigen aus der aktuellen Tabelle gebildet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ronda se genera a partir de la clasificación más reciente cuando termina la anterior."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen kierros muodostetaan tuoreimman sarjataulukon perusteella, kun edellinen päättyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque tour est établi selon le dernier classement à la fin du précédent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni turno viene composto in base all’ultima classifica quando termina il precedente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ラウンドは、前のラウンド終了時の最新の順位をもとに組まれます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver runde settes opp fra den siste tabellen når forrige runde er ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke ronde wordt na afloop van de vorige ingedeeld op basis van het actuele klassement."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda runda jest ustalana według aktualnej tabeli po zakończeniu poprzedniej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada rodada é definida pela classificação atual quando a anterior termina."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ronda é definida pela classificação atual quando a anterior termina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый раунд составляется по текущей таблице, когда заканчивается предыдущий."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje runda sätts ihop utifrån den senaste tabellen när föregående runda är klar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每轮在上一轮结束后根据最新排名生成。"
          }
        }
      }
    },
