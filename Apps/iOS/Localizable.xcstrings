    "Balance the groups for equal playing time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وازن بين الفئات لتحقيق وقت لعب متساوٍ."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibra els grups perquè tothom jugui el mateix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyrovnejte skupiny, aby všichni hráli stejně dlouho."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afbalancer grupperne, så alle får lige meget spilletid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleiche die Gruppen aus, damit alle gleich viel spielen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibra los grupos para que todos jueguen lo mismo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasapainota ryhmät, jotta peliaika jakautuu tasaisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Équilibrez les groupes pour un temps de jeu égal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilancia i gruppi per avere lo stesso tempo di gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレー時間を均等にするため、グループの人数をそろえてください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Balanser gruppene for lik spilletid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak de groepen even groot voor gelijke speeltijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyrównaj grupy, aby każdy grał tyle samo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibre os grupos para terem o mesmo tempo de jogo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibre os grupos para terem o mesmo tempo de jogo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уравняйте группы, чтобы игровое время было равным."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jämna ut grupperna för lika mycket speltid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请平衡各组人数，使上场时间相等。"
          }
        }
