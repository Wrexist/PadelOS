    "Points per match can only be changed before the first point is played.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تغيير النقاط لكل مباراة إلا قبل لعب النقطة الأولى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els punts per partit només es poden canviar abans de jugar el primer punt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet bodů na zápas lze změnit jen před odehráním prvního bodu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Point pr. kamp kan kun ændres, før det første point er spillet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Punkte pro Match können nur vor dem ersten gespielten Punkt geändert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los puntos por partido solo se pueden cambiar antes de jugar el primer punto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottelukohtaisia pisteitä voi muuttaa vain ennen ensimmäistä pistettä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les points par match ne peuvent être modifiés qu’avant le premier point joué."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I punti per partita si possono modificare solo prima che venga giocato il primo punto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1試合のポイント数は、最初のポイントがプレーされる前にのみ変更できます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Poeng per kamp kan bare endres før det første poenget er spilt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Punten per wedstrijd kun je alleen wijzigen voordat het eerste punt is gespeeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczbę punktów na mecz można zmienić tylko przed rozegraniem pierwszego punktu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pontos por partida só podem ser alterados antes do primeiro ponto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pontos por partida só podem ser alterados antes de se jogar o primeiro ponto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Число очков за матч можно изменить только до первого розыгрыша."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Poäng per match kan bara ändras innan första poängen har spelats."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每场比赛总分只能在第一分开始前更改。"
          }
        }
      }
    },
