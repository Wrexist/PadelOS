    "Results already played are kept. Rounds that have not started are rebuilt without them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ النتائج التي لُعبت بالفعل. يُعاد إنشاء الجولات التي لم تبدأ بدونهم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els resultats ja jugats es conserven. Les rondes que no han començat es tornen a generar sense ells."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Již odehrané výsledky zůstanou. Kola, která nezačala, se sestaví znovu bez nich."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultater, der allerede er spillet, bevares. Runder, der ikke er startet, laves om uden dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits gespielte Ergebnisse bleiben erhalten. Nicht begonnene Runden werden ohne sie neu erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados ya jugados se conservan. Las rondas que no han empezado se regeneran sin ellos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo pelatut tulokset säilyvät. Alkamattomat kierrokset muodostetaan uudelleen ilman heitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats déjà joués sont conservés. Les tours non commencés sont recréés sans eux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I risultati già giocati vengono conservati. I turni non ancora iniziati vengono ricreati senza di loro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに出た結果は保持されます。未開始のラウンドは、その人を除いて再作成されます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultater som allerede er spilt, beholdes. Runder som ikke har startet, settes opp på nytt uten dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al gespeelde uitslagen blijven behouden. Rondes die nog niet begonnen zijn, worden zonder hen opnieuw opgebouwd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyniki już rozegranych meczów zostają. Nierozpoczęte rundy zostaną ułożone od nowa bez nich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os resultados já jogados são mantidos. As rodadas que ainda não começaram são refeitas sem quem saiu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os resultados já jogados são mantidos. As rondas que ainda não começaram são refeitas sem quem saiu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже сыгранные результаты сохраняются. Не начатые раунды пересоздаются без них."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redan spelade resultat behålls. Rundor som inte har börjat byggs om utan dem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有结果将保留。尚未开始的轮次会在排除其后重新生成。"
          }
        }
      }
    },
