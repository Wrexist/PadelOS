    "Standings appear as soon as the first match is finished.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر الترتيب بمجرد انتهاء أول مباراة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La classificació apareix tan bon punt acaba el primer partit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pořadí se zobrazí hned po dokončení prvního zápasu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stillingen vises, så snart den første kamp er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tabelle erscheint, sobald das erste Match beendet ist."
