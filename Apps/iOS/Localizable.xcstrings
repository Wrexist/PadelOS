    "Winners move up a court, losers move down": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصعد الفائزون ملعبًا وينزل الخاسرون"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els guanyadors pugen de pista i els perdedors baixen"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vítězové o kurt výš, poražení o kurt níž"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinderne rykker en bane op, taberne en ned"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieger steigen einen Platz auf, Verlierer ab"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ganadores suben de pista y los perdedores bajan"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voittajat nousevat kentän ylöspäin, häviäjät laskevat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les gagnants montent d’un terrain, les perdants descendent"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I vincitori salgono di un campo, i perdenti scendono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勝者は上のコートへ、敗者は下のコートへ"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinnerne flytter opp én bane, taperne ned"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Winnaars een baan omhoog, verliezers omlaag"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwycięzcy idą o kort w górę, przegrani w dół"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vencedores sobem uma quadra, perdedores descem"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os vencedores sobem um campo, os derrotados descem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Победители переходят на корт выше, проигравшие — ниже"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinnarna flyttar upp en bana, förlorarna ner"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "胜者升场，负者降场"
          }
        }
      }
    },
    "With an odd total, rest points are rounded down to %lld.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يكون المجموع فرديًا، تُقرَّب نقاط الاستراحة إلى %lld."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb un total senar, els punts per descans s'arrodoneixen a la baixa a %lld."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při lichém součtu se body za odpočinek zaokrouhlí dolů na %lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med et ulige antal point i alt rundes point for at sidde over ned til %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei ungerader Gesamtzahl werden Pausenpunkte auf %lld abgerundet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un total impar, los puntos por descanso se redondean a la baja a %lld."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Parittomalla kokonaismäärällä lepopisteet pyöristetään alaspäin: %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un total impair, les points de repos sont arrondis à %lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un totale dispari, i punti per il riposo sono arrotondati per difetto a %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合計が奇数の場合、休みのポイントは%lldに切り捨てられます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med oddetall som total rundes hvilepoengene ned til %lld."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij een oneven totaal worden rustpunten afgerond naar %lld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy nieparzystej sumie punkty za pauzę są zaokrąglane w dół do %lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com um total ímpar, os pontos por folga são arredondados para baixo, para %lld."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com um total ímpar, os pontos por descanso são arredondados para baixo, para %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При нечётной сумме очки за отдых округляются вниз до %lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med en udda totalpoäng avrundas vilopoängen nedåt till %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总分为奇数时，轮休得分向下取整为%lld分。"
          }
        }
      }
    },
    "With fixed teams, add a whole team.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع الفرق الثابتة، أضف فريقًا كاملًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb parelles fixes, afegeix un equip sencer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U pevných týmů přidejte celý tým."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med faste hold skal du tilføje et helt hold."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei festen Teams füge ein ganzes Team hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con parejas fijas, añade un equipo completo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiinteissä joukkueissa lisää kokonainen joukkue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec des équipes fixes, ajoutez une équipe complète."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con squadre fisse, aggiungi una squadra intera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定チームの場合は、チーム単位で追加してください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med faste lag må du legge til et helt lag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg bij vaste teams een heel team toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy stałych drużynach dodaj całą drużynę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com duplas fixas, adicione uma dupla completa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com equipas fixas, adicione uma equipa completa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При постоянных командах добавляйте команду целиком."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med fasta lag lägger du till ett helt lag."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定队伍赛制下，请添加整支队伍。"
          }
        }
      }
    },
    "With fixed teams, withdraw the whole team.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع الفرق الثابتة، اسحب الفريق بأكمله."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb parelles fixes, retira l'equip sencer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U pevných týmů odhlaste celý tým."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med faste hold skal du trække hele holdet ud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei festen Teams ziehe das ganze Team zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con parejas fijas, retira el equipo completo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiinteissä joukkueissa poista pelistä koko joukkue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec des équipes fixes, retirez l’équipe entière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con squadre fisse, ritira l’intera squadra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定チームの場合は、チーム単位で棄権してください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med faste lag må du trekke hele laget."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek bij vaste teams het hele team terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy stałych drużynach wycofaj całą drużynę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com duplas fixas, retire a dupla inteira."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com equipas fixas, retire a equipa inteira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При постоянных командах снимайте команду целиком."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med fasta lag drar du ur hela laget."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定队伍赛制下，请让整支队伍退赛。"
          }
        }
      }
    },
    "With one court, King of the Court has no courts to move between.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع ملعب واحد، لا توجد ملاعب للتنقّل بينها في ملك الملعب."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb una sola pista, al Rei de la pista no hi ha pistes entre les quals moure's."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S jedním kurtem nemá Král kurtu mezi čím postupovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med kun én bane har King of the Court ingen baner at rykke mellem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit nur einem Platz gibt es bei King of the Court keinen Platzwechsel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una sola pista, en Rey de la pista no hay pistas entre las que moverse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdellä kentällä King of the Courtissa ei ole kenttiä, joiden välillä siirtyä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un seul terrain, le King of the Court n’a aucun terrain entre lesquels circuler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un solo campo, King of the Court non ha campi tra cui spostarsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コートが1面だと、キング・オブ・ザ・コートでは移動先のコートがありません。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med én bane har King of the Court ingen baner å flytte mellom."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met één baan kan er bij King of the Court niet van baan worden gewisseld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy jednym korcie w formacie Król kortu nie ma między czym się przesuwać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma só quadra, o Rei da Quadra não tem para onde subir ou descer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com um só campo, o Rei do Campo não tem para onde subir ou descer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С одним кортом в «Короле корта» некуда переходить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med bara en bana finns det inga banor att flytta mellan i King of the Court."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有一个场地时，擂台赛无法在场地间升降。"
          }
        }
      }
    },
    "Withdraw": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
