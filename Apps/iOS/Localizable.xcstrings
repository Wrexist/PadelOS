    "It appears here automatically. Then you can score without your phone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيظهر هنا تلقائيًا. بعدها يمكنك تسجيل النتيجة دون هاتفك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Apareixerà aquí automàticament. Llavors podràs anotar sense l'iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Objeví se tu automaticky. Pak můžete počítat skóre bez telefonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den vises automatisk her. Så kan du tælle point uden din telefon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es erscheint hier automatisch. Dann kannst du ohne dein iPhone zählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparecerá aquí automáticamente. Así podrás anotar sin el iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se näkyy täällä automaattisesti. Sen jälkeen voit laskea pisteitä ilman puhelinta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il apparaîtra ici automatiquement. Vous pourrez alors compter les points sans votre téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparirà qui automaticamente. Poi potrai segnare i punti senza il telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに自動的に表示されます。その後はiPhoneなしでスコアを記録できます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den vises her automatisk. Da kan du føre poeng uten telefonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verschijnt hier automatisch. Dan kun je scoren zonder je telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojawi się tutaj automatycznie. Wtedy możesz liczyć punkty bez telefonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele aparece aqui automaticamente. Depois você pode marcar pontos sem o celular."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece aqui automaticamente. Depois pode marcar pontos sem o telemóvel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он появится здесь автоматически. Затем можно вести счёт без телефона."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den dyker upp här automatiskt. Sedan kan du räkna poäng utan telefonen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会自动显示在这里。之后无需手机即可记分。"
          }
        }
      }
    },
    "It may have been deleted.": {
