          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il torneo e tutti i risultati verranno rimossi da questo iPhone. L’operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大会とすべての結果がこのiPhoneから削除されます。この操作は取り消せません。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
