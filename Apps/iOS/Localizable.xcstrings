    "Every score and result in this tournament will be cleared. This cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم مسح كل النقاط والنتائج في هذه البطولة. لا يمكن التراجع عن ذلك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'esborraran tots els marcadors i resultats d'aquest torneig. Aquesta acció no es pot desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechna skóre a výsledky v tomto turnaji budou vymazány. Tuto akci nelze vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle point og resultater i denne turnering bliver slettet. Det kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Stände und Ergebnisse dieses Turniers werden gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán todos los marcadores y resultados de este torneo. Esta acción no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki tämän turnauksen pisteet ja tulokset tyhjennetään. Tätä ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les scores et résultats de ce tournoi seront effacés. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i punteggi e i risultati di questo torneo verranno cancellati. L’operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この大会のすべてのスコアと結果が消去されます。この操作は取り消せません。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle poeng og resultater i denne turneringen slettes. Dette kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle scores en uitslagen van dit toernooi worden gewist. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie punkty i wyniki w tym turnieju zostaną wyczyszczone. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os placares e resultados deste torneio serão apagados. Essa ação não pode ser desfeita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os pontos e resultados deste torneio serão apagados. Esta ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все счета и результаты этого турнира будут удалены. Это действие нельзя отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla poäng och resultat i den här turneringen raderas. Det går inte att ångra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此赛事的所有比分和结果都将被清除。此操作无法撤销。"
          }
        }
      }
    },
    "Every team has one player from each group": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل فريق يضم لاعبًا من كل فئة"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada equip té un jugador de cada grup"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý tým má jednoho hráče z každé skupiny"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert hold har én spiller fra hver gruppe"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Team hat einen Spieler aus jeder Gruppe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada equipo tiene un jugador de cada grupo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokaisessa joukkueessa on yksi pelaaja kummastakin ryhmästä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque équipe compte un joueur de chaque groupe"
          }
        },
