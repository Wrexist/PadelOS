    "Choose 1 to 3 sets to win and 2 to 9 games per set.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر من 1 إلى 3 مجموعات للفوز ومن 2 إلى 9 أشواط لكل مجموعة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria d'1 a 3 sets per guanyar i de 2 a 9 jocs per set."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte 1 až 3 vítězné sety a 2 až 9 gemů v setu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg 1 til 3 sæt for at vinde og 2 til 9 games pr. sæt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle 1 bis 3 Gewinnsätze und 2 bis 9 Spiele pro Satz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige de 1 a 3 sets para ganar y de 2 a 9 juegos por set."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse voittoon vaadittavat erät (1–3) ja pelit erässä (2–9)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez de 1 à 3 sets gagnants et de 2 à 9 jeux par set."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli da 1 a 3 set da vincere e da 2 a 9 game per set."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勝利に必要なセット数は1〜3、1セットのゲーム数は2〜9で選んでください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg 1 til 3 sett for seier og 2 til 9 game per sett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies 1 tot 3 winnende sets en 2 tot 9 games per set."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz od 1 do 3 setów do wygrania i od 2 do 9 gemów w secie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha de 1 a 3 sets para vencer e de 2 a 9 games por set."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha de 1 a 3 sets para vencer e de 2 a 9 jogos por set."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите от 1 до 3 сетов для победы и от 2 до 9 геймов в сете."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
