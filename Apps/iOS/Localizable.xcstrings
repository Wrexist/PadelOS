    "Fixed teams meet teams with the same record, no rematches": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فرق ثابتة تواجه فرقًا بالسجل نفسه، دون تكرار المواجهات"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Parelles fixes contra equips amb el mateix balanç, sense repetir enfrontaments"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pevné týmy hrají proti týmům se stejnou bilancí, bez odvet"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Faste hold møder hold med samme resultat, ingen genmøder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feste Teams treffen auf Teams mit gleicher Bilanz, ohne Wiederholungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parejas fijas contra equipos con el mismo balance, sin repetir cruces"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiinteät joukkueet kohtaavat yhtä hyvin menestyneitä, ei uusintaotteluita"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Équipes fixes contre des équipes au bilan identique, sans revanche"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Squadre fisse contro squadre con lo stesso record, senza rivincite"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定チームが同じ成績のチームと対戦、再戦なし"
