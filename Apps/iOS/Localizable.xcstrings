    "Add one more player to complete the last team.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف لاعبًا آخر لإكمال الفريق الأخير."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix un jugador més per completar l'últim equip."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte ještě jednoho hráče, aby byl poslední tým kompletní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj én spiller mere for at fuldende det sidste hold."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge noch einen Spieler hinzu, um das letzte Team zu vervollständigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un jugador más para completar el último equipo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täydennä viimeinen joukkue lisäämällä vielä yksi pelaaja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un joueur pour compléter la dernière équipe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un giocatore per completare l’ultima squadra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後のチームを組むために、もう1人追加してください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til én spiller til for å fullføre det siste laget."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg nog één speler toe om het laatste team compleet te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj jeszcze jednego gracza, aby uzupełnić ostatnią drużynę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione mais um jogador para completar a última dupla."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione mais um jogador para completar a última equipa."
          }
        },
        "ru": {
          "stringUnit": {
