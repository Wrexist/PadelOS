    "Works fully offline. No account, no tracking. Tournaments are stored only on this iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل دون اتصال بالكامل. بلا حساب وبلا تتبّع. تُخزَّن البطولات على جهاز iPhone هذا فقط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona completament sense connexió. Sense compte ni seguiment. Els tornejos només es desen en aquest iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Funguje plně offline. Bez účtu, bez sledování. Turnaje se ukládají jen v tomto iPhonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Virker helt offline. Ingen konto, ingen sporing. Turneringer gemmes kun på denne iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert komplett offline. Kein Account, kein Tracking. Turniere werden nur auf diesem iPhone gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona totalmente sin conexión. Sin cuenta ni rastreo. Los torneos solo se guardan en este iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toimii täysin ilman verkkoa. Ei tiliä, ei seurantaa. Turnaukset tallennetaan vain tähän iPhoneen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne entièrement hors ligne. Aucun compte, aucun suivi. Les tournois sont stockés uniquement sur cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona completamente offline. Nessun account, nessun tracciamento. I tornei vengono salvati solo su questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全にオフラインで動作します。アカウント不要、トラッキングなし。大会はこのiPhoneにのみ保存されます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fungerer helt uten nett. Ingen konto, ingen sporing. Turneringer lagres bare på denne iPhonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkt volledig offline. Geen account, geen tracking. Toernooien worden alleen op deze iPhone bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa w pełni offline. Bez konta, bez śledzenia. Turnieje są przechowywane tylko na tym iPhonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona totalmente offline. Sem conta, sem rastreamento. Os torneios ficam salvos apenas neste iPhone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona totalmente offline. Sem conta, sem rastreio. Os torneios ficam guardados apenas neste iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает полностью офлайн. Без учётной записи и отслеживания. Турниры хранятся только на этом iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fungerar helt offline. Inget konto, ingen spårning. Turneringar sparas bara på den här iPhonen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全离线运行。无需账户，不做跟踪。赛事仅保存在这台 iPhone 上。"
          }
        }
      }
    },
