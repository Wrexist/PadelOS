    "Partners rotate every round. Both players on a team receive the team's points. Ranked by total points, then wins, then point difference.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبدّل الشركاء في كل جولة. يحصل لاعبا الفريق كلاهما على نقاط الفريق. الترتيب حسب مجموع النقاط ثم الانتصارات ثم فارق النقاط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les parelles canvien a cada ronda. Tots dos jugadors d'un equip reben els punts de l'equip. Classificació per punts totals, després victòries i després diferència de punts."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoluhráči se střídají každé kolo. Oba hráči týmu získají body týmu. Pořadí: celkové body, poté výhry, poté rozdíl bodů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Makkerne skifter hver runde. Begge spillere på et hold får holdets point. Rangeres efter samlede point, derefter sejre og derefter pointforskel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Partner wechseln jede Runde. Beide Spieler eines Teams erhalten die Punkte des Teams. Wertung nach Gesamtpunkten, dann Siegen, dann Punktdifferenz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las parejas cambian en cada ronda. Los dos jugadores de un equipo reciben los puntos del equipo. Clasificación por puntos totales, luego victorias y luego diferencia de puntos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Parit vaihtuvat joka kierroksella. Joukkueen molemmat pelaajat saavat joukkueen pisteet. Sijoitus kokonaispisteiden, sitten voittojen ja lopuksi piste-eron mukaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les partenaires changent à chaque tour. Les deux joueurs d’une équipe reçoivent les points de l’équipe. Classement par points totaux, puis victoires, puis différence de points."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I compagni cambiano a ogni turno. Entrambi i giocatori di una squadra ricevono i punti della squadra. Classifica per punti totali, poi vittorie, poi differenza punti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パートナーは毎ラウンド入れ替わります。チームの得点はペアの2人それぞれに加算されます。順位は合計ポイント、勝利数、得失点差の順で決まります。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Makkerne roterer hver runde. Begge spillerne på et lag får lagets poeng. Rangeres etter totalpoeng, deretter seire og så poengdifferanse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Partners wisselen elke ronde. Beide spelers van een team krijgen de punten van het team. Rangschikking op totaal punten, dan overwinningen, dan puntensaldo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Partnerzy zmieniają się co rundę. Obaj gracze drużyny dostają jej punkty. Kolejność: suma punktów, potem wygrane, potem różnica punktów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os parceiros mudam a cada rodada. Os dois jogadores da dupla recebem os pontos da dupla. Classificação por pontos totais, depois vitórias e saldo de pontos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os parceiros mudam em cada ronda. Os dois jogadores de uma equipa recebem os pontos da equipa. Classificação por pontos totais, depois vitórias e diferença de pontos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Партнёры меняются каждый раунд. Оба игрока команды получают её очки. Рейтинг: сумма очков, затем победы, затем разница очков."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Partnerna byts varje runda. Båda spelarna i ett lag får lagets poäng. Rankas efter totalpoäng, sedan vinster, sedan poängskillnad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每轮轮换搭档。队伍中的两名球员都获得该队得分。依次按总分、胜场、分差排名。"
          }
        }
      }
    },
