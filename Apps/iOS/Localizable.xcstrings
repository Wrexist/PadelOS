    "The tournament and all results are removed from this iPhone. This cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُزال البطولة وجميع النتائج من جهاز iPhone هذا. لا يمكن التراجع عن ذلك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El torneig i tots els resultats s'eliminaran d'aquest iPhone. Aquesta acció no es pot desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Turnaj a všechny výsledky budou z tohoto iPhonu odstraněny. Tuto akci nelze vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Turneringen og alle resultater fjernes fra denne iPhone. Det kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Turnier und alle Ergebnisse werden von diesem iPhone entfernt. Dies kann nicht widerrufen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El torneo y todos sus resultados se eliminarán de este iPhone. Esta acción no se puede deshacer."
