    "Played rounds and results are always kept. Only rounds that have not started are rebuilt.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ الجولات الملعوبة والنتائج دائمًا. لا يُعاد إنشاء إلا الجولات التي لم تبدأ."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rondes jugades i els resultats es conserven sempre. Només es tornen a generar les rondes que no han començat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odehraná kola a výsledky zůstávají vždy zachovány. Znovu se sestaví jen kola, která nezačala."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spillede runder og resultater bevares altid. Kun runder, der ikke er startet, laves om."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespielte Runden und Ergebnisse bleiben immer erhalten. Nur nicht begonnene Runden werden neu erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las rondas jugadas y los resultados se conservan siempre. Solo se regeneran las rondas que no han empezado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelatut kierrokset ja tulokset säilyvät aina. Vain alkamattomat kierrokset muodostetaan uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tours joués et les résultats sont toujours conservés. Seuls les tours non commencés sont recréés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I turni giocati e i risultati vengono sempre conservati. Vengono ricreati solo i turni non ancora iniziati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実施済みのラウンドと結果は常に保持されます。再作成されるのは未開始のラウンドのみです。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilte runder og resultater beholdes alltid. Bare runder som ikke har startet, settes opp på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeelde rondes en uitslagen blijven altijd behouden. Alleen rondes die nog niet begonnen zijn, worden opnieuw opgebouwd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozegrane rundy i wyniki są zawsze zachowywane. Od nowa układane są tylko nierozpoczęte rundy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As rodadas jogadas e os resultados são sempre mantidos. Só são refeitas as rodadas que ainda não começaram."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As rondas jogadas e os resultados são sempre mantidos. Só são refeitas as rondas que ainda não começaram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сыгранные раунды и результаты всегда сохраняются. Пересоздаются только не начатые раунды."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelade rundor och resultat behålls alltid. Bara rundor som inte har börjat byggs om."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已进行的轮次和结果始终保留。只有尚未开始的轮次会重新生成。"
          }
        }
      }
    },
