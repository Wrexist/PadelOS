    "Choose either a final round from the standings or playoffs, not both.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر إما جولة نهائية حسب الترتيب أو أدوارًا إقصائية، وليس كليهما."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria una ronda final segons la classificació o eliminatòries, però no totes dues."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte buď finálové kolo podle pořadí, nebo play-off, ne obojí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg enten en finalerunde ud fra stillingen eller slutspil, ikke begge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle entweder eine Finalrunde nach Tabelle oder Playoffs, nicht beides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una ronda final según la clasificación o eliminatorias, pero no ambas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse joko finaalikierros sarjataulukon mukaan tai pudotuspelit, ei molempia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez soit un tour final selon le classement, soit une phase finale, pas les deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un turno finale dalla classifica oppure i playoff, non entrambi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "順位による最終ラウンドかプレーオフのどちらか一方を選んでください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg enten en finalerunde fra tabellen eller sluttspill, ikke begge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een finaleronde op klassement of play-offs, niet allebei."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz rundę finałową według tabeli albo play-offy, nie oba naraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma rodada final pela classificação ou mata-mata, não os dois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma ronda final pela classificação ou eliminatórias, não ambas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите либо финальный раунд по таблице, либо плей-офф — не оба сразу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj antingen en finalrunda utifrån tabellen eller slutspel, inte båda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在按排名决赛轮和淘汰赛中二选一。"
          }
        }
      }
    },
