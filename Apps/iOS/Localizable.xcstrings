    "Americano, Mexicano, team formats, King of the Court and playoffs. Partners, opponents and rests are balanced for you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أمريكانو ومكسيكانو وصيغ الفرق وملك الملعب والأدوار الإقصائية. يتم توزيع الشركاء والخصوم والاستراحات بعدل تلقائيًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Americano, Mexicano, formats per equips, Rei de la pista i eliminatòries. Les parelles, els rivals i els descansos s'equilibren automàticament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Americano, Mexicano, týmové formáty, Král kurtu a play-off. Spoluhráče, soupeře i pauzy vyváží aplikace za vás."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Americano, Mexicano, holdformater, King of the Court og slutspil. Makkere, modstandere og pauser fordeles retfærdigt for dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Americano, Mexicano, Teamformate, King of the Court und Playoffs. Partner, Gegner und Pausen werden fair für dich verteilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Americano, Mexicano, formatos por equipos, Rey de la pista y eliminatorias. Las parejas, los rivales y los descansos se equilibran automáticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Americano, Mexicano, joukkuepelimuodot, King of the Court ja pudotuspelit. Parit, vastustajat ja lepovuorot tasapainotetaan puolestasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Americano, Mexicano, formats par équipes, King of the Court et phases finales. Partenaires, adversaires et repos sont équilibrés pour vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Americano, Mexicano, formati a squadre, King of the Court e playoff. Compagni, avversari e turni di riposo vengono bilanciati per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アメリカーノ、メキシカーノ、チーム形式、キング・オブ・ザ・コート、プレーオフに対応。パートナー、対戦相手、休みは自動で公平に割り振られます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Americano, Mexicano, lagformater, King of the Court og sluttspill. Makkere, motstandere og hvilerunder fordeles rettferdig for deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Americano, Mexicano, teamformats, King of the Court en play-offs. Partners, tegenstanders en rustbeurten worden eerlijk voor je verdeeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Americano, Mexicano, formaty drużynowe, Król kortu i play-offy. Partnerzy, rywale i pauzy są rozłożeni sprawiedliwie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Americano, Mexicano, formatos em duplas, Rei da Quadra e mata-mata. Parceiros, adversários e folgas equilibrados automaticamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Americano, Mexicano, formatos por equipas, Rei do Campo e eliminatórias. Parceiros, adversários e descansos equilibrados automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Американо, Мексикано, командные форматы, «Король корта» и плей-офф. Партнёры, соперники и отдых распределяются автоматически и честно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Americano, Mexicano, lagformat, King of the Court och slutspel. Partner, motståndare och vilorundor fördelas jämnt åt dig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 Americano、Mexicano、组队赛制、擂台赛和淘汰赛。搭档、对手和轮休都会自动均衡分配。"
          }
        }
      }
    },
