    "Rest points are only available with a fixed points total.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقاط الاستراحة متاحة فقط مع مجموع نقاط ثابت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els punts per descans només estan disponibles amb un total de punts fix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Body za odpočinek jsou k dispozici jen při pevném počtu bodů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Point for at sidde over kræver et fast antal point i alt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausenpunkte gibt es nur bei fester Gesamtpunktzahl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los puntos por descanso solo están disponibles con un total de puntos fijo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lepopisteet ovat käytettävissä vain kiinteällä pistemäärällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les points de repos ne sont disponibles qu’avec un total de points fixe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I punti per il riposo sono disponibili solo con un totale di punti fisso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休みのポイントは、合計ポイント固定の場合のみ使用できます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilepoeng er bare tilgjengelig med fast totalpoengsum."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rustpunten zijn alleen beschikbaar met een vast puntentotaal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Punkty za pauzę są dostępne tylko przy stałej liczbie punktów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pontos por folga só estão disponíveis com um total de pontos fixo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pontos por descanso só estão disponíveis com um total de pontos fixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очки за отдых доступны только при фиксированной сумме очков."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilopoäng går bara att använda med en fast totalpoäng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轮休得分仅适用于固定总分的赛制。"
          }
        }
      }
    },
