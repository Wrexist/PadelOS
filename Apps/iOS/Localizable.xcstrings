            "state": "translated",
            "value": "Ogni squadra ha un giocatore per gruppo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各チームに各グループから1人ずつ"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert lag har én spiller fra hver gruppe"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk team heeft één speler uit elke groep"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
