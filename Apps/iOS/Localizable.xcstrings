    "A final round needs at least one round before it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تسبق الجولةَ النهائية جولةٌ واحدة على الأقل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La ronda final necessita almenys una ronda prèvia."
          }
        },
