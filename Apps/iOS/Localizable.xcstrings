          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea torneo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大会を作成"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett turnering"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
