    "Turn off rest points or use a points total.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف نقاط الاستراحة أو استخدم مجموع نقاط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva els punts per descans o fes servir un total de punts."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypněte body za odpočinek, nebo použijte pevný počet bodů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå point for at sidde over fra, eller brug et antal point i alt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Pausenpunkte aus oder nutze eine Gesamtpunktzahl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva los puntos por descanso o usa un total de puntos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista lepopisteet käytöstä tai käytä kiinteää pistemäärää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez les points de repos ou utilisez un total de points."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva i punti per il riposo o usa un totale di punti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休みのポイントをオフにするか、合計ポイント制にしてください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå av hvilepoeng eller bruk en totalpoengsum."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet rustpunten uit of gebruik een puntentotaal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz punkty za pauzę lub ustaw stałą liczbę punktów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative os pontos por folga ou use um total de pontos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative os pontos por descanso ou use um total de pontos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключите очки за отдых или используйте сумму очков."
          }
        },
        "sv": {
