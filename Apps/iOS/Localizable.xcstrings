    "One name per line, or separated by commas.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم واحد في كل سطر، أو افصل بينها بفواصل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom per línia o separats per comes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno jméno na řádek, nebo oddělená čárkami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét navn pr. linje eller adskilt med kommaer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Name pro Zeile oder durch Kommas getrennt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre por línea o separados por comas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi nimi riville tai pilkuilla erotettuina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom par ligne, ou séparés par des virgules."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nome per riga, oppure separati da virgole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1行に1人ずつ、またはカンマ区切りで入力してください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett navn per linje, eller skilt med komma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén naam per regel, of gescheiden door komma's."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno imię w wierszu lub oddzielone przecinkami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um nome por linha ou separados por vírgulas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um nome por linha ou separados por vírgulas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По одному имени в строке или через запятую."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett namn per rad, eller separerade med kommatecken."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一个姓名，或用逗号分隔。"
          }
        }
      }
    },
    "One tap per point on Apple Watch. It keeps scoring even when your iPhone stays in the bag.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقرة واحدة لكل نقطة على Apple Watch. يستمر التسجيل حتى لو بقي iPhone في الحقيبة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toc per punt a l'Apple Watch. Continua anotant encara que l'iPhone es quedi a la bossa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno klepnutí na bod na Apple Watch. Počítá dál, i když iPhone zůstane v tašce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét tryk pr. point på Apple Watch. Det bliver ved med at tælle, selv når din iPhone bliver i tasken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tippen pro Punkt auf der Apple Watch. Das Zählen klappt auch, wenn dein iPhone in der Tasche bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque por punto en el Apple Watch. Sigue anotando aunque el iPhone se quede en la bolsa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi napautus per piste Apple Watchissa. Pistelasku jatkuu, vaikka iPhone jäisi laukkuun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toucher par point sur l’Apple Watch. Le comptage continue même quand votre iPhone reste dans le sac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tocco per punto su Apple Watch. Il punteggio continua anche quando l’iPhone resta nella borsa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watchで1ポイントにつき1タップ。iPhoneがバッグの中にあってもスコアを記録できます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett trykk per poeng på Apple Watch. Poengføringen fortsetter selv om iPhonen blir liggende i bagen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén tik per punt op de Apple Watch. Scoren werkt ook als je iPhone in de tas blijft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno stuknięcie na punkt na Apple Watch. Liczy dalej, nawet gdy iPhone zostaje w torbie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque por ponto no Apple Watch. Continua marcando mesmo com o iPhone na mochila."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque por ponto no Apple Watch. Continua a marcar mesmo com o iPhone no saco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно касание — одно очко на Apple Watch. Счёт ведётся, даже когда iPhone остаётся в сумке."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett tryck per poäng på Apple Watch. Den fortsätter räkna även när din iPhone ligger kvar i väskan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple Watch 上轻点一下即记一分。即使 iPhone 留在包里，也能继续记分。"
          }
        }
      }
    },
    "Only %lld of %lld courts can be used with these players.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد الملاعب المتاحة مع هؤلاء اللاعبين: %lld من %lld."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb aquests jugadors només es poden fer servir %lld de %lld pistes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S těmito hráči lze využít jen %lld z %lld kurtů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun %lld af %lld baner kan bruges med disse spillere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit diesen Spielern können nur %lld von %lld Plätzen genutzt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con estos jugadores solo se pueden usar %lld de %lld pistas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näillä pelaajilla voidaan käyttää vain %lld/%lld kenttää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls %lld terrains sur %lld peuvent être utilisés avec ces joueurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con questi giocatori si possono usare solo %lld campi su %lld."
          }
