    },
    "Mexicano with your two groups: each court gets the next two players of each group, and every team has one of each.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكسيكانو بفئتيك: يحصل كل ملعب على اللاعبَين التاليين من كل فئة، ويضم كل فريق لاعبًا من كل منهما."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mexicano amb els teus dos grups: cada pista rep els dos jugadors següents de cada grup, i cada equip en té un de cada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mexicano se dvěma skupinami: na každý kurt jdou další dva hráči z každé skupiny a každý tým má po jednom z obou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mexicano med dine to grupper: hver bane får de næste to spillere fra hver gruppe, og hvert hold har én af hver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mexicano mit deinen zwei Gruppen: Jeder Platz bekommt die nächsten zwei Spieler jeder Gruppe, und jedes Team hat einen aus jeder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mexicano con tus dos grupos: cada pista recibe a los dos siguientes jugadores de cada grupo, y cada equipo tiene uno de cada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mexicano kahdella ryhmälläsi: jokaiselle kentälle tulee kummastakin ryhmästä kaksi seuraavaa pelaajaa, ja jokaisessa joukkueessa on yksi kummastakin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mexicano avec vos deux groupes : chaque terrain reçoit les deux joueurs suivants de chaque groupe, et chaque équipe compte un joueur de chaque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mexicano con i tuoi due gruppi: ogni campo riceve i due giocatori successivi di ciascun gruppo e ogni squadra ha un giocatore per gruppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つのグループで行うメキシカーノです。各コートには各グループから次の2人ずつが入り、各チームは各グループ1人ずつで組まれます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mexicano med de to gruppene dine: hver bane får de to neste spillerne fra hver gruppe, og hvert lag har én fra hver."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mexicano met je twee groepen: elke baan krijgt de volgende twee spelers van elke groep, en elk team heeft er één van elk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mexicano z dwiema grupami: na każdy kort trafia dwóch kolejnych graczy z każdej grupy, a w każdej drużynie jest po jednym z obu grup."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mexicano com seus dois grupos: cada quadra recebe os próximos dois jogadores de cada grupo, e cada dupla tem um de cada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mexicano com os seus dois grupos: cada campo recebe os dois jogadores seguintes de cada grupo e cada equipa tem um de cada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мексикано с двумя группами: на каждый корт выходят следующие два игрока из каждой группы, и в каждой команде по игроку из каждой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mexicano med dina två grupper: varje bana får de två nästa spelarna från varje grupp, och varje lag har en av varje."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用两组球员的 Mexicano：每个场地依次分配每组的两名球员，每支队伍各有一名来自两组的球员。"
          }
        }
      }
    },
