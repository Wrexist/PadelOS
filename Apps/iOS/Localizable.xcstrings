    "Teams are only used in fixed-team formats.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم الفرق فقط في الصيغ ذات الفرق الثابتة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els equips només s'utilitzen en formats de parelles fixes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Týmy se používají jen ve formátech s pevnými týmy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold bruges kun i formater med faste hold."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teams gibt es nur in Formaten mit festen Teams."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los equipos solo se usan en formatos de parejas fijas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Joukkueita käytetään vain kiinteiden joukkueiden pelimuodoissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les équipes ne servent que dans les formats à équipes fixes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le squadre si usano solo nei formati a squadre fisse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームは固定チーム形式でのみ使用されます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lag brukes bare i formater med faste lag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teams worden alleen gebruikt in formats met vaste teams."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drużyny są używane tylko w formatach ze stałymi drużynami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As duplas só são usadas nos formatos de duplas fixas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As equipas só são usadas nos formatos de equipas fixas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команды используются только в форматах с постоянными командами."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lag används bara i format med fasta lag."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队伍仅用于固定队伍赛制。"
          }
        }
      }
    },
    "That point was already undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم التراجع عن تلك النقطة بالفعل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest punt ja s'ha desfet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento bod už byl vrácen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det point er allerede fortrudt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Punkt wurde bereits widerrufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese punto ya se deshizo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piste on jo peruttu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce point a déjà été annulé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo punto è già stato annullato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのポイントはすでに取り消されています。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det poenget er allerede angret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat punt is al ongedaan gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten punkt został już cofnięty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse ponto já foi desfeito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse ponto já foi desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это очко уже отменено."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den poängen är redan ångrad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该分已被撤销。"
          }
        }
      }
    },
    "The bracket is drawn from the standings after round %lld.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحدَّد شبكة الأدوار الإقصائية حسب الترتيب بعد الجولة %lld."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El quadre es genera a partir de la classificació després de la ronda %lld."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pavouk se sestaví podle pořadí po kole %lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slutspilstræet sammensættes ud fra stillingen efter runde %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Turnierbaum ergibt sich aus der Tabelle nach Runde %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cuadro se genera a partir de la clasificación tras la ronda %lld."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
