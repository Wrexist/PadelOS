    "Check the standings, then finish the tournament to lock the results.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع الترتيب، ثم أنهِ البطولة لتثبيت النتائج."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la classificació i finalitza el torneig per tancar els resultats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte pořadí a pak turnaj ukončete, aby se výsledky uzamkly."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek stillingen, og afslut derefter turneringen for at låse resultaterne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Tabelle und beende dann das Turnier, um die Ergebnisse festzuschreiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la clasificación y finaliza el torneo para cerrar los resultados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista sarjataulukko ja lukitse tulokset päättämällä turnaus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le classement, puis terminez le tournoi pour verrouiller les résultats."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la classifica, poi termina il torneo per bloccare i risultati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "順位を確認してから大会を終了し、結果を確定してください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk tabellen, og avslutt turneringen for å låse resultatene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer het klassement en rond dan het toernooi af om de uitslagen vast te leggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź tabelę, a potem zakończ turniej, aby zatwierdzić wyniki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira a classificação e finalize o torneio para travar os resultados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a classificação e termine o torneio para fixar os resultados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте таблицу и завершите турнир, чтобы зафиксировать результаты."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera tabellen och avsluta sedan turneringen för att låsa resultaten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查排名，然后结束赛事以锁定结果。"
          }
        }
      }
