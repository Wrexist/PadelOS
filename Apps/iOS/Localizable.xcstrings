    "%@-%@": {
      "shouldTranslate": false
    },
    "%@. Equal on all of these means a shared position (=).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. التساوي في كل ذلك يعني مركزًا مشتركًا (=)."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Si hi ha empat en tots aquests criteris, es comparteix la posició (=)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Shoda ve všech kritériích znamená dělené místo (=)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Lige på alle disse betyder delt placering (=)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Wer überall gleichauf ist, teilt sich den Rang (=)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Si hay empate en todos estos criterios, se comparte la posición (=)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Jos kaikki nämä ovat tasan, sijoitus on jaettu (=)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Une égalité sur tous ces critères donne une place partagée (=)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. In caso di parità su tutti questi criteri, la posizione è condivisa (=)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。すべて同じ場合は同順位（=）になります。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Likt på alle disse gir delt plassering (=)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Wie op alles gelijk staat, deelt de plaats (=)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Równość we wszystkich kryteriach oznacza wspólne miejsce (=)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Empate em todos esses critérios significa posição compartilhada (=)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Igualdade em todos estes critérios significa posição partilhada (=)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. При равенстве по всем показателям место делится (=)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Lika i alla dessa innebär delad placering (=)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。以上各项均相同则名次并列（=）。"
          }
        }
      }
    },
    "%lld": {
      "shouldTranslate": false
    },
    "%lld %@": {
      "shouldTranslate": false
    },
