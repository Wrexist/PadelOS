    "Rounds already played: %lld. The tournament cannot have fewer rounds than that.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجولات التي لُعبت: %lld. لا يمكن أن يكون عدد جولات البطولة أقل من ذلك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Rondes ja jugades: %lld. El torneig no pot tenir menys rondes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odehraná kola: %lld. Turnaj nemůže mít méně kol."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spillede runder: %lld. Turneringen kan ikke have færre runder end det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits gespielte Runden: %lld. Das Turnier kann nicht weniger Runden haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rondas ya jugadas: %lld. El torneo no puede tener menos rondas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo pelattuja kierroksia: %lld. Turnauksessa ei voi olla tätä vähemmän kierroksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tours déjà joués : %lld. Le tournoi ne peut pas en compter moins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Turni già giocati: %lld. Il torneo non può averne di meno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実施済みのラウンド：%lld。大会のラウンド数をこれより少なくすることはできません。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Runder som allerede er spilt: %lld. Turneringen kan ikke ha færre runder enn det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al gespeelde rondes: %lld. Het toernooi kan niet minder rondes hebben."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozegrane rundy: %lld. Turniej nie może mieć mniej rund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodadas já jogadas: %lld. O torneio não pode ter menos rodadas do que isso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Rondas já jogadas: %lld. O torneio não pode ter menos rondas do que isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже сыграно раундов: %lld. В турнире не может быть меньше раундов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelade rundor: %lld. Turneringen kan inte ha färre rundor än så."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已进行轮数：%lld。赛事轮数不能少于此数。"
          }
        }
      }
    },
    "Rounds are created from the standings when the previous round is complete.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنشأ الجولات حسب الترتيب عند اكتمال الجولة السابقة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rondes es generen a partir de la classificació quan s'acaba la ronda anterior."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kola se sestavují podle pořadí po dokončení předchozího kola."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Runderne dannes ud fra stillingen, når den forrige runde er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Runden werden aus der Tabelle erstellt, sobald die vorherige Runde abgeschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las rondas se generan a partir de la clasificación cuando se completa la ronda anterior."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kierrokset muodostetaan sarjataulukon perusteella, kun edellinen kierros on päättynyt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tours sont créés selon le classement une fois le tour précédent terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I turni vengono creati in base alla classifica quando il turno precedente è completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ラウンドは、前のラウンドが終わった時点の順位から作成されます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rundene settes opp fra tabellen når forrige runde er ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rondes worden op basis van het klassement gemaakt zodra de vorige ronde klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rundy są tworzone według tabeli po zakończeniu poprzedniej rundy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As rodadas são criadas a partir da classificação quando a rodada anterior termina."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As rondas são criadas a partir da classificação quando a ronda anterior termina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раунды составляются по таблице после завершения предыдущего раунда."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rundorna skapas utifrån tabellen när föregående runda är klar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每轮在上一轮完成后根据排名生成。"
          }
        }
      }
    },
