    "Correcting a finished match updates the standings. Rounds that have already started are never changed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصحيح مباراة منتهية يحدّث الترتيب. لا تتغير الجولات التي بدأت بالفعل أبدًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Corregir un partit acabat actualitza la classificació. Les rondes ja començades no es modifiquen mai."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprava dokončeného zápasu aktualizuje pořadí. Kola, která už začala, se nikdy nemění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du retter en afsluttet kamp, opdateres stillingen. Runder, der allerede er startet, ændres aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du ein beendetes Match korrigierst, wird die Tabelle aktualisiert. Bereits begonnene Runden werden nie geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corregir un partido terminado actualiza la clasificación. Las rondas ya empezadas nunca se modifican."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päättyneen ottelun korjaaminen päivittää sarjataulukon. Jo alkaneita kierroksia ei koskaan muuteta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corriger un match terminé met à jour le classement. Les tours déjà commencés ne sont jamais modifiés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Correggere una partita conclusa aggiorna la classifica. I turni già iniziati non vengono mai modificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了した試合を修正すると順位表が更新されます。すでに始まっているラウンドは変更されません。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du korrigerer en ferdig kamp, oppdateres tabellen. Runder som allerede har startet, endres aldri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je een afgeronde wedstrijd corrigeert, wordt het klassement bijgewerkt. Rondes die al begonnen zijn, worden nooit gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprawienie zakończonego meczu aktualizuje tabelę. Rozpoczęte rundy nigdy nie są zmieniane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrigir uma partida finalizada atualiza a classificação. Rodadas já iniciadas nunca são alteradas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrigir uma partida terminada atualiza a classificação. As rondas já iniciadas nunca são alteradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исправление завершённого матча обновит таблицу. Уже начатые раунды никогда не изменяются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du korrigerar en avslutad match uppdateras tabellen. Rundor som redan har börjat ändras aldrig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更正已结束的比赛会更新排名。已开始的轮次不会被更改。"
          }
        }
      }
    },
