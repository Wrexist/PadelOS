    "Match duration must be between 3 and 90 minutes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تكون مدة المباراة بين 3 و90 دقيقة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La durada del partit ha de ser d'entre 3 i 90 minuts."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Délka zápasu musí být 3 až 90 minut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kampens varighed skal være mellem 3 og 90 minutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Matchdauer muss zwischen 3 und 90 Minuten liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La duración del partido debe estar entre 3 y 90 minutos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottelun keston on oltava 3–90 minuuttia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La durée d’un match doit être comprise entre 3 et 90 minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La durata della partita deve essere compresa tra 3 e 90 minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試合時間は3〜90分にしてください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamplengden må være mellom 3 og 90 minutter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wedstrijdduur moet tussen 3 en 90 minuten liggen."
          }
        },
        "pl": {
