    "Create a tournament in under a minute. Fair schedules, live scores and standings — all in one place.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ بطولة في أقل من دقيقة. جداول عادلة ونتائج مباشرة وترتيب — كل ذلك في مكان واحد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un torneig en menys d'un minut. Calendaris justos, marcadors en directe i classificació — tot en un sol lloc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvořte turnaj za necelou minutu. Férový rozpis, živé skóre a pořadí — vše na jednom místě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret en turnering på under et minut. Retfærdige programmer, live-score og stillinger — samlet ét sted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle ein Turnier in unter einer Minute. Faire Spielpläne, Live-Stände und Tabellen – alles an einem Ort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un torneo en menos de un minuto. Calendarios justos, marcadores en tiempo real y clasificación — todo en un solo lugar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo turnaus alle minuutissa. Reilut otteluohjelmat, live-tulokset ja sarjataulukko — kaikki yhdessä paikassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un tournoi en moins d’une minute. Programme équitable, scores en direct et classement — tout au même endroit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un torneo in meno di un minuto. Calendari equilibrati, punteggi live e classifiche — tutto in un unico posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1分以内で大会を作成。公平な対戦表、ライブスコア、順位表をひとつの場所で。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett en turnering på under ett minutt. Rettferdige kampoppsett, live-resultater og tabell — alt på ett sted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een toernooi in minder dan een minuut. Eerlijke schema's, live scores en klassementen – alles op één plek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz turniej w niecałą minutę. Sprawiedliwy terminarz, wyniki na żywo i tabela — wszystko w jednym miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um torneio em menos de um minuto. Rodadas equilibradas, placar ao vivo e classificação — tudo em um só lugar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um torneio em menos de um minuto. Calendários justos, resultados em direto e classificação — tudo num só lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте турнир меньше чем за минуту. Честное расписание, счёт в реальном времени и таблица — всё в одном месте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa en turnering på under en minut. Rättvisa scheman, liveresultat och tabeller — allt på ett ställe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一分钟内创建赛事。公平的赛程、实时比分和排名，尽在一处。"
          }
        }
      }
    },
