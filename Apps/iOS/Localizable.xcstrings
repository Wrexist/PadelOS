    "The final round is drawn from the standings after the last regular round.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحدَّد الجولة النهائية حسب الترتيب بعد آخر جولة عادية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La ronda final es genera a partir de la classificació després de l'última ronda regular."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Finálové kolo se sestaví podle pořadí po posledním základním kole."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalerunden sammensættes ud fra stillingen efter den sidste almindelige runde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Finalrunde ergibt sich aus der Tabelle nach der letzten regulären Runde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ronda final se genera a partir de la clasificación tras la última ronda regular."
          }
