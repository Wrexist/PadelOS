    "Fixed teams play a round robin. Teams are ranked by total points, wins, head-to-head, then point difference.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فرق ثابتة تلعب بنظام الدوري. تُرتَّب الفرق حسب مجموع النقاط، ثم الانتصارات، ثم المواجهات المباشرة، ثم فارق النقاط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les parelles fixes juguen una lligueta (tots contra tots). Els equips es classifiquen per punts totals, victòries, enfrontament directe i, finalment, diferència de punts."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pevné týmy hrají každý s každým. Pořadí určují celkové body, výhry, vzájemné zápasy a poté rozdíl bodů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Faste hold spiller alle mod alle. Holdene rangeres efter samlede point, sejre, indbyrdes opgør og derefter pointforskel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feste Teams spielen jeder gegen jeden. Wertung nach Gesamtpunkten, Siegen, direktem Vergleich, dann Punktdifferenz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las parejas fijas juegan una liguilla (todos contra todos). Los equipos se clasifican por puntos totales, victorias, enfrentamiento directo y, por último, diferencia de puntos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiinteät joukkueet pelaavat kaikki kaikkia vastaan. Joukkueet sijoitetaan kokonaispisteiden, voittojen, keskinäisten otteluiden ja lopuksi piste-eron mukaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les équipes fixes s’affrontent toutes. Elles sont classées par points totaux, victoires, confrontations directes, puis différence de points."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le squadre fisse giocano un girone all’italiana. Sono classificate per punti totali, vittorie, scontri diretti e poi differenza punti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定チームによる総当たり戦です。順位は合計ポイント、勝利数、直接対決、得失点差の順で決まります。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Faste lag spiller alle mot alle. Lagene rangeres etter totalpoeng, seire, innbyrdes oppgjør og deretter poengdifferanse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaste teams spelen een round robin. Rangschikking op totaal punten, overwinningen, onderling resultaat en dan puntensaldo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stałe drużyny grają każdy z każdym. O kolejności decydują suma punktów, wygrane, mecze bezpośrednie, a potem różnica punktów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As duplas fixas jogam todas contra todas. Classificação por pontos totais, vitórias, confronto direto e saldo de pontos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As equipas fixas jogam todas contra todas. Classificação por pontos totais, vitórias, confronto direto e diferença de pontos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Постоянные команды играют по круговой системе. Рейтинг: сумма очков, победы, личные встречи, затем разница очков."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasta lag spelar alla mot alla. Lagen rankas efter totalpoäng, vinster, inbördes möten och sedan poängskillnad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定队伍进行循环赛。依次按总分、胜场、相互战绩、分差排名。"
          }
        }
      }
    },
    "Fixed teams. Each round, teams with the same number of wins play each other, and no two teams meet twice. Ranked by wins, then total points.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فرق ثابتة. في كل جولة تتواجه الفرق التي لها العدد نفسه من الانتصارات، ولا يلتقي فريقان مرتين. الترتيب حسب الانتصارات ثم مجموع النقاط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Parelles fixes. A cada ronda s'enfronten els equips amb el mateix nombre de victòries, i cap enfrontament no es repeteix. Classificació per victòries i després per punts totals."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pevné týmy. V každém kole hrají proti sobě týmy se stejným počtem výher a žádné dva týmy se nepotkají dvakrát. Pořadí: výhry, poté celkové body."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Faste hold. Hver runde mødes hold med lige mange sejre, og ingen hold mødes to gange. Rangeres efter sejre og derefter samlede point."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feste Teams. In jeder Runde spielen Teams mit gleich vielen Siegen gegeneinander, und keine zwei Teams treffen zweimal aufeinander. Wertung nach Siegen, dann Gesamtpunkten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parejas fijas. En cada ronda se enfrentan los equipos con el mismo número de victorias, y ningún enfrentamiento se repite. Clasificación por victorias y luego por puntos totales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiinteät joukkueet. Joka kierroksella yhtä monta voittoa saaneet joukkueet pelaavat vastakkain, eivätkä samat joukkueet kohtaa kahdesti. Sijoitus voittojen ja sitten kokonaispisteiden mukaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Équipes fixes. À chaque tour, les équipes ayant le même nombre de victoires s’affrontent, sans jamais se rencontrer deux fois. Classement par victoires, puis par points totaux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Squadre fisse. A ogni turno si affrontano le squadre con lo stesso numero di vittorie e nessuna coppia di squadre si incontra due volte. Classifica per vittorie, poi per punti totali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定チーム形式です。各ラウンドで勝利数が同じチーム同士が対戦し、同じ組み合わせの再戦はありません。順位は勝利数、次に合計ポイントで決まります。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Faste lag. I hver runde møtes lag med like mange seire, og ingen lag møtes to ganger. Rangeres etter seire, deretter totalpoeng."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaste teams. Elke ronde spelen teams met evenveel overwinningen tegen elkaar en geen twee teams treffen elkaar twee keer. Rangschikking op overwinningen, dan totaal punten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stałe drużyny. W każdej rundzie drużyny z tą samą liczbą wygranych grają ze sobą, a żadne dwie drużyny nie spotykają się dwa razy. Kolejność: wygrane, potem suma punktów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplas fixas. A cada rodada, duplas com o mesmo número de vitórias se enfrentam, e nenhuma dupla enfrenta a mesma duas vezes. Classificação por vitórias e depois pontos totais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Equipas fixas. Em cada ronda, as equipas com o mesmo número de vitórias jogam entre si e nenhuma equipa defronta outra duas vezes. Classificação por vitórias e depois pontos totais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Постоянные команды. В каждом раунде играют команды с одинаковым числом побед, и никакие две команды не встречаются дважды. Рейтинг: победы, затем сумма очков."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasta lag. Varje runda möts lag med lika många vinster, och inga lag möts två gånger. Rankas efter vinster och sedan totalpoäng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定队伍。每轮由胜场数相同的队伍交手，任意两队不会重复对阵。依次按胜场、总分排名。"
          }
        }
      }
    },
    "Fixed teams; after round 1 the 1st team plays the 2nd, the 3rd plays the 4th, avoiding repeat meetings where possible.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فرق ثابتة؛ بعد الجولة الأولى يلعب الفريق الأول مع الثاني، والثالث مع الرابع، مع تجنّب تكرار المواجهات قدر الإمكان."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Parelles fixes; després de la ronda 1, el 1r equip juga contra el 2n i el 3r contra el 4t, evitant repetir enfrontaments sempre que sigui possible."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pevné týmy; po 1. kole hraje 1. tým s 2. a 3. se 4., pokud možno bez opakovaných střetnutí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Faste hold; efter runde 1 spiller nr. 1 mod nr. 2 og nr. 3 mod nr. 4, og gentagne møder undgås så vidt muligt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feste Teams; nach Runde 1 spielt das 1. Team gegen das 2., das 3. gegen das 4. – Wiederholungen werden möglichst vermieden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parejas fijas; tras la ronda 1, el 1.º equipo juega contra el 2.º y el 3.º contra el 4.º, evitando repetir enfrentamientos siempre que sea posible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiinteät joukkueet; kierroksen 1 jälkeen sijat 1 ja 2 pelaavat vastakkain, samoin sijat 3 ja 4. Samoja kohtaamisia vältetään mahdollisuuksien mukaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Équipes fixes ; après le tour 1, la 1re équipe affronte la 2e, la 3e affronte la 4e, en évitant si possible les rencontres répétées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Squadre fisse; dopo il turno 1 la 1ª squadra gioca contro la 2ª, la 3ª contro la 4ª, evitando se possibile di ripetere gli incontri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定チーム形式です。ラウンド1以降は1位と2位、3位と4位が対戦し、できるだけ再戦を避けます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Faste lag; etter runde 1 spiller lag nr. 1 mot nr. 2 og nr. 3 mot nr. 4, og gjentatte møter unngås der det er mulig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaste teams; na ronde 1 speelt het 1e team tegen het 2e en het 3e tegen het 4e, waarbij herhalingen zo veel mogelijk worden vermeden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stałe drużyny; po 1. rundzie 1. drużyna gra z 2., a 3. z 4., w miarę możliwości bez powtórzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplas fixas; após a rodada 1, a 1ª dupla joga contra a 2ª e a 3ª contra a 4ª, evitando confrontos repetidos sempre que possível."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Equipas fixas; após a ronda 1, a 1.ª equipa joga com a 2.ª e a 3.ª com a 4.ª, evitando repetir confrontos sempre que possível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Постоянные команды; после 1-го раунда 1-я команда играет со 2-й, 3-я — с 4-й, по возможности без повторных встреч."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasta lag; efter runda 1 möter ettan tvåan och trean fyran, och upprepade möten undviks om möjligt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定队伍；第1轮之后，第1名对第2名，第3名对第4名，并尽量避免重复对阵。"
          }
        }
      }
    },
    "Follow the score in the Dynamic Island and add points without unlocking your iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع النتيجة في Dynamic Island وأضف النقاط دون فتح قفل iPhone."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Segueix el marcador a la Dynamic Island i suma punts sense desbloquejar l'iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte skóre v oblasti Dynamic Island a přidávejte body bez odemykání iPhonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg scoren i Dynamic Island, og tilføj point uden at låse din iPhone op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge den Stand in der Dynamic Island und vergib Punkte, ohne dein iPhone zu entsperren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue el marcador en la Dynamic Island y suma puntos sin desbloquear el iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa tilannetta Dynamic Islandissa ja lisää pisteitä avaamatta iPhonen lukitusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez le score dans la Dynamic Island et ajoutez des points sans déverrouiller votre iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui il punteggio nella Dynamic Island e aggiungi punti senza sbloccare l’iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Islandでスコアを確認し、iPhoneのロックを解除せずにポイントを追加できます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg stillingen i Dynamic Island og legg til poeng uten å låse opp iPhonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg de score in het Dynamic Island en voeg punten toe zonder je iPhone te ontgrendelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź wynik w Dynamic Island i dodawaj punkty bez odblokowywania iPhone’a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe o placar na Dynamic Island e adicione pontos sem desbloquear o iPhone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe o resultado na Dynamic Island e adicione pontos sem desbloquear o iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следите за счётом в Dynamic Island и добавляйте очки, не разблокируя iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följ ställningen i Dynamic Island och lägg till poäng utan att låsa upp din iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在灵动岛中查看比分，无需解锁 iPhone 即可加分。"
          }
        }
      }
    },
