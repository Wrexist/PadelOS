          "stringUnit": {
            "state": "translated",
            "value": "Použijte alespoň 2 kurty, nebo zvolte Americano."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug 2 eller flere baner, eller vælg Americano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze 2 oder mehr Plätze oder wähle Americano."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa 2 pistas o más, o elige Americano."
          }
        },
        "fi": {
