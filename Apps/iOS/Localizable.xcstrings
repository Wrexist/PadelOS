    "Players are paired in the order entered: 1 & 2, 3 & 4, … Drag to change teams.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُقرن اللاعبون بترتيب إدخالهم: 1 & 2، 3 & 4، … اسحب لتغيير الفرق."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els jugadors s'aparellen en l'ordre introduït: 1 & 2, 3 & 4, … Arrossega per canviar els equips."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hráči se párují v pořadí zadání: 1 & 2, 3 & 4, … Přetažením změníte týmy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spillerne parres i den rækkefølge, de er indtastet: 1 & 2, 3 & 4, … Træk for at skifte hold."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spieler werden in der eingegebenen Reihenfolge gepaart: 1 & 2, 3 & 4, … Zum Ändern der Teams ziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los jugadores se emparejan en el orden introducido: 1 & 2, 3 & 4, … Arrastra para cambiar los equipos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelaajat paritetaan syöttöjärjestyksessä: 1 & 2, 3 & 4, … Vaihda joukkueita vetämällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les joueurs sont associés dans l’ordre de saisie : 1 & 2, 3 & 4, … Faites glisser pour changer les équipes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giocatori vengono abbinati nell’ordine inserito: 1 & 2, 3 & 4, … Trascina per cambiare le squadre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力した順にペアが組まれます：1 & 2、3 & 4、… ドラッグしてチームを変更できます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spillerne settes sammen i rekkefølgen de ble lagt inn: 1 & 2, 3 & 4, … Dra for å bytte lag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelers worden gekoppeld in de ingevoerde volgorde: 1 & 2, 3 & 4, … Sleep om teams te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracze są łączeni w pary w kolejności wpisania: 1 & 2, 3 & 4, … Przeciągnij, aby zmienić drużyny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os jogadores formam duplas na ordem inserida: 1 & 2, 3 & 4, … Arraste para mudar as duplas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os jogadores formam pares pela ordem introduzida: 1 & 2, 3 & 4, … Arraste para mudar as equipas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игроки объединяются в пары по порядку ввода: 1 & 2, 3 & 4, … Перетащите, чтобы изменить команды."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelarna paras ihop i den ordning de anges: 1 & 2, 3 & 4, … Dra för att byta lag."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按输入顺序配对：1 & 2、3 & 4、… 拖移即可更改队伍。"
          }
        }
      }
    },
    "Playoff matches are drawn from the standings after the last regular round.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحدَّد مباريات الأدوار الإقصائية حسب الترتيب بعد آخر جولة عادية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els partits de les eliminatòries es generen a partir de la classificació després de l'última ronda regular."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zápasy play-off se sestaví podle pořadí po posledním základním kole."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slutspilskampene sammensættes ud fra stillingen efter den sidste almindelige runde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Playoff-Matches ergeben sich aus der Tabelle nach der letzten regulären Runde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los partidos de las eliminatorias se generan a partir de la clasificación tras la última ronda regular."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pudotuspelien ottelut muodostetaan sarjataulukon perusteella viimeisen runkosarjakierroksen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les matchs de la phase finale sont établis selon le classement après le dernier tour régulier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partite dei playoff vengono composte in base alla classifica dopo l’ultimo turno regolare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレーオフの組み合わせは、最後の通常ラウンド後の順位で決まります。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluttspillkampene settes opp fra tabellen etter siste ordinære runde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Play-offwedstrijden volgen uit het klassement na de laatste reguliere ronde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mecze play-off są ustalane według tabeli po ostatniej rundzie zasadniczej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As partidas do mata-mata são definidas pela classificação após a última rodada regular."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As partidas das eliminatórias são definidas pela classificação após a última ronda regular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Матчи плей-офф формируются по таблице после последнего обычного раунда."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slutspelsmatcherna sätts ihop utifrån tabellen efter den sista ordinarie rundan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
