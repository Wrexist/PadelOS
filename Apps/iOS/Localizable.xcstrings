          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criar torneio"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Criar torneio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создать турнир"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa turnering"
          }
        },
        "zh-Hans": {
