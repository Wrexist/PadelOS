    "A saved tournament could not be read and was set aside (%@).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة بطولة محفوظة فتم تجنيبها (%@)."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut llegir un torneig desat i s'ha deixat de banda (%@)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložený turnaj nelze přečíst, a proto byl odložen (%@)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En gemt turnering kunne ikke læses og blev lagt til side (%@)."
          }
        },
