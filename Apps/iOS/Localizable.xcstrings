    "No account. No ads. Works offline. Your tournaments stay on your devices.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا حساب. بلا إعلانات. يعمل دون اتصال. تبقى بطولاتك على أجهزتك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense compte. Sense anuncis. Funciona sense connexió. Els teus tornejos es queden als teus dispositius."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez účtu. Bez reklam. Funguje offline. Vaše turnaje zůstávají ve vašich zařízeních."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konto. Ingen reklamer. Virker offline. Dine turneringer bliver på dine enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Account. Keine Werbung. Funktioniert offline. Deine Turniere bleiben auf deinen Geräten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta. Sin anuncios. Funciona sin conexión. Tus torneos se quedan en tus dispositivos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei tiliä. Ei mainoksia. Toimii ilman verkkoa. Turnauksesi pysyvät laitteillasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte. Aucune pub. Fonctionne hors ligne. Vos tournois restent sur vos appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account. Nessuna pubblicità. Funziona offline. I tuoi tornei restano sui tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント不要、広告なし、オフラインで動作。大会のデータはデバイス内に保存されます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konto. Ingen reklame. Fungerer uten nett. Turneringene dine blir på enhetene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen account. Geen advertenties. Werkt offline. Je toernooien blijven op je apparaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez konta. Bez reklam. Działa offline. Twoje turnieje zostają na Twoich urządzeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta. Sem anúncios. Funciona offline. Seus torneios ficam nos seus dispositivos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta. Sem anúncios. Funciona offline. Os seus torneios ficam nos seus dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без учётной записи. Без рекламы. Работает офлайн. Ваши турниры остаются на ваших устройствах."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget konto. Ingen reklam. Fungerar offline. Dina turneringar stannar på dina enheter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账户，没有广告，可离线使用。你的赛事保留在你的设备上。"
          }
        }
      }
    },
