    "%@ was saved by a newer app version (%lld > %lld). Update the app to open it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ %@ بإصدار أحدث من التطبيق (%lld > %lld). حدّث التطبيق لفتحه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es va desar amb una versió més recent de l'app (%lld > %lld). Actualitza l'app per obrir-lo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: uloženo novější verzí aplikace (%lld > %lld). Pro otevření aplikaci aktualizujte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ blev gemt af en nyere version af appen (%lld > %lld). Opdater appen for at åbne den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde mit einer neueren App-Version gesichert (%lld > %lld). Aktualisiere die App, um es zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se guardó con una versión más reciente de la app (%lld > %lld). Actualiza la app para abrirlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on tallennettu sovelluksen uudemmalla versiolla (%lld > %lld). Avaa se päivittämällä sovellus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été enregistré par une version plus récente de l’app (%lld > %lld). Mettez l’app à jour pour l’ouvrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stato salvato da una versione più recente dell’app (%lld > %lld). Aggiorna l’app per aprirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は新しいバージョンのアプリで保存されています（%lld > %lld）。開くにはアプリをアップデートしてください。"
