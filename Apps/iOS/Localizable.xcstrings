    "Final standings are locked. You can reopen the tournament later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الترتيب النهائي مثبّت. يمكنك إعادة فتح البطولة لاحقًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La classificació final està tancada. Pots reobrir el torneig més endavant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Konečné pořadí je uzamčeno. Turnaj můžete později znovu otevřít."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slutstillingen er låst. Du kan genåbne turneringen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Abschlusstabelle ist festgeschrieben. Du kannst das Turnier später wieder öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clasificación final está cerrada. Puedes reabrir el torneo más adelante."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lopullinen sarjataulukko on lukittu. Voit avata turnauksen myöhemmin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le classement final est verrouillé. Vous pourrez rouvrir le tournoi plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La classifica finale è bloccata. Puoi riaprire il torneo in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終順位が確定しました。大会はあとで再開できます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den endelige tabellen er låst. Du kan gjenåpne turneringen senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het eindklassement staat vast. Je kunt het toernooi later heropenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabela końcowa jest zablokowana. Turniej możesz później otworzyć ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A classificação final está travada. Você pode reabrir o torneio depois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A classificação final está fechada. Pode reabrir o torneio mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Итоговая таблица зафиксирована. Турнир можно открыть снова позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slutställningen är låst. Du kan öppna turneringen igen senare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最终排名已锁定。你可以稍后重新开启赛事。"
          }
        }
      }
    },
