    "%@ has %lld and %@ has %lld players. %@ players will rest more often.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد اللاعبين في %@: %lld، وفي %@: %lld. سيستريح لاعبو %@ أكثر من غيرهم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ té %lld jugadors i %@ en té %lld. Els jugadors de %@ descansaran més sovint."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet hráčů – %@: %lld, %@: %lld. Hráči ze skupiny %@ budou častěji odpočívat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har %lld og %@ har %lld spillere. Spillere i %@ kommer til at sidde over oftere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld, %@: %lld Spieler. Spieler aus %@ pausieren häufiger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiene %lld jugadores y %@ tiene %lld. Los jugadores de %@ descansarán más a menudo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryhmässä %@ on %lld ja ryhmässä %@ %lld pelaajaa. Ryhmän %@ pelaajat lepäävät useammin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : %lld joueurs, %@ : %lld joueurs. Les joueurs du groupe %@ se reposeront plus souvent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha %lld giocatori e %@ ne ha %lld. I giocatori del gruppo %@ riposeranno più spesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は%lld人、%@は%lld人です。%@のプレーヤーは休みが多くなります。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har %lld og %@ har %lld spillere. Spillerne i %@ står over oftere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld, %@: %lld spelers. Spelers uit %@ rusten vaker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba graczy – %@: %lld, %@: %lld. Gracze z grupy %@ będą częściej pauzować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tem %lld e %@ tem %lld jogadores. Os jogadores de %@ vão folgar mais vezes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tem %lld e %@ tem %lld jogadores. Os jogadores de %@ vão descansar mais vezes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игроков в группе %@: %lld, в группе %@: %lld. Игроки группы %@ будут отдыхать чаще."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har %lld och %@ har %lld spelare. Spelare i %@ kommer att stå över oftare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@有%lld人，%@有%lld人。%@的球员轮休次数会更多。"
          }
        }
      }
    },
