    "Create one in under a minute. No account needed — everything stays on this iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ واحدة في أقل من دقيقة. لا حاجة إلى حساب — كل شيء يبقى على جهاز iPhone هذا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea'n un en menys d'un minut. No cal cap compte — tot es queda en aquest iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvoříte ho za necelou minutu. Bez účtu — vše zůstane v tomto iPhonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret en på under et minut. Ingen konto nødvendig — alt bliver på denne iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In unter einer Minute erstellt. Kein Account nötig – alles bleibt auf diesem iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea uno en menos de un minuto. No necesitas cuenta — todo se queda en este iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo turnaus alle minuutissa. Tiliä ei tarvita — kaikki pysyy tässä iPhonessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez-en un en moins d’une minute. Aucun compte requis — tout reste sur cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creane uno in meno di un minuto. Nessun account richiesto — tutto resta su questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1分以内で作成できます。アカウントは不要で、すべてのデータはこのiPhoneに保存されます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett en på under ett minutt. Ingen konto nødvendig — alt blir værende på denne iPhonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak er een in minder dan een minuut. Geen account nodig – alles blijft op deze iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utworzysz go w niecałą minutę. Bez konta — wszystko zostaje na tym iPhonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um em menos de um minuto. Sem precisar de conta — tudo fica neste iPhone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um em menos de um minuto. Não precisa de conta — tudo fica neste iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это займёт меньше минуты. Без учётной записи — всё хранится на этом iPhone."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa en på under en minut. Inget konto behövs — allt stannar på den här iPhonen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一分钟内即可创建。无需账户——所有数据都保存在这台 iPhone 上。"
          }
        }
      }
    },
