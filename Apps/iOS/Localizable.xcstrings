    "Play together.\nKeep score.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العبوا معًا.\nوسجّلوا النتيجة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Juga amb amics.\nPorta el marcador."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hrajte spolu.\nPočítejte skóre."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spil sammen.\nHold styr på scoren."
          }
        },
        "de": {
