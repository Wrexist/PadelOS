    "Padel nights,\nperfectly run.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليالي البادل\nبتنظيم مثالي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Nits de pàdel,\nben organitzades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Padelové večery\nbez chaosu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Padelaftener,\nperfekt afviklet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Padel-Abende,\nperfekt organisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noches de pádel,\nbien organizadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Padel-illat\nilman säätöä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos soirées padel,\nparfaitement gérées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serate di padel,\norganizzate alla perfezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パデルの夜を、\n完璧に運営。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Padelkvelder,\nperfekt gjennomført."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Padelavonden,\nperfect geregeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Padlowe wieczory\nbez chaosu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Noites de padel,\nsem complicação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Noites de padel,\nsem falhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Падел-вечера —\nбез хлопот."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Padelkvällar\nsom bara flyter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Padel之夜，\n井井有条。"
          }
        }
      }
