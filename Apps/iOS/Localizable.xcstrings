        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clasificación aparece en cuanto termina el primer partido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarjataulukko näkyy heti, kun ensimmäinen ottelu on päättynyt."
          }
        },
        "fr": {
